COMPOSE_PROJECT_NAME=ab
COMPOSE_FILE=dev/docker-compose.yml

PHP_VERSION=8.4
PHP_IDE_CONFIG="serverName=ab_server_mapping"

XDEBUG_VERSION=3.4.1
XDEBUG_MODE=debug
XDEBUG_CLIENT_HOST=dockerhost
XDEBUG_CLIENT_PORT=9003
XDEBUG_START_WITH_REQUEST=yes
XDEBUG_DISCOVER_CLIENT_HOST=on
EXT_DB_PORT=11000
EXT_WEB_PORT=3000
